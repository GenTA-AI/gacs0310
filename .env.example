# GACS Research Pipeline - Environment Variables
# Copy this file to .env and fill in your values

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Quick test mode (set to 1 to enable)
GACS_QUICK_TEST=0

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
GACS_LOG_LEVEL=INFO


# Google OAuth (download client_secrets.json from Google Cloud Console)
# See README.md for setup instructions

# Webhook security (Task 1.2)
DID_WEBHOOK_SECRET=your_hmac_secret_here_min_32_chars

# Infrastructure
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://gacs_user@staging.gacs.internal:5432/gacs_staging
WEBHOOK_PORT=3000

# Application
NODE_ENV=development
LOG_LEVEL=info
