# GACS Research Pipeline - Environment Variables
# Copy this file to .env and fill in your values

# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Quick test mode (set to 1 to enable)
GACS_QUICK_TEST=0

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
GACS_LOG_LEVEL=INFO

# Google OAuth (download client_secrets.json from Google Cloud Console)
# See README.md for setup instructions

# ---------------------------------------------------------------------------
# Local dev infrastructure (Phase 2 — added via docker-compose)
# ---------------------------------------------------------------------------

# Postgres (matches docker-compose.yml defaults)
POSTGRES_DB=gacs
POSTGRES_USER=gacs
POSTGRES_PASSWORD=gacs_dev
DATABASE_URL=postgresql://gacs:gacs_dev@localhost:5432/gacs

# Redis
REDIS_URL=redis://localhost:6379

# Smart DID (Challenge 1 — mock for local dev until sandbox credentials land)
DID_WEBHOOK_SECRET=local-dev-secret-replace-me
DID_API_BASE_URL=http://localhost:9000/mock-did

# YouTube (Challenge 2 — populate when sandbox is ready)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
